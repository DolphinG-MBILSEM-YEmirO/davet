{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/events/:id/comments/:commentId",
      "destination": "/api/events?id=:id&action=comments&commentId=:commentId"
    },
    {
      "source": "/api/events/:id/:action",
      "destination": "/api/events?id=:id&action=:action"
    },
    {
      "source": "/api/events/:id",
      "destination": "/api/events?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
